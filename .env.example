# API Configuration
# Modes: 'dev' or 'prod'
VITE_API_MODE=dev

# Production proxy host (host-only, no /proxy suffix)
VITE_PROD_API_URL=https://proxy.yourdomain.com

# Development proxy host (host-only, no /proxy suffix)
VITE_DEV_API_URL=http://localhost:4000

# App Configuration
VITE_APP_NAME=TMAT Monitor
